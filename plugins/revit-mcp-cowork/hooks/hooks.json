{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c .\\scripts\\node-hook.cmd .\\hooks\\session-start.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*revit.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c .\\scripts\\node-hook.cmd .\\hooks\\pre-tool.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*revit.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c .\\scripts\\node-hook.cmd .\\hooks\\post-tool.js"
          }
        ]
      }
    ]
  }
}
