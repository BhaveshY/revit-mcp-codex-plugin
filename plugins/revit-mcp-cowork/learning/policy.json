{
  "schema_version": 1,
  "delivery": "local-user-skill-only",
  "lookback_days": 14,
  "history_source": "codex-desktop-task-tools",
  "history_task_limit": 50,
  "history_turn_page_size": 50,
  "fail_on_history_saturation": true,
  "history_checkpoint_storage": "PLUGIN_DATA/local-learning/review-checkpoint.json",
  "history_overlap_hours": 24,
  "store_duplicate_raw_transcripts": false,
  "minimum_occurrences": 3,
  "minimum_independent_sessions": 2,
  "local_skill_name": "revit-mcp-local-guidance",
  "local_skill_location": "$HOME/.agents/skills/revit-mcp-local-guidance",
  "max_active_rules": 12,
  "max_rule_updates_per_cycle": 2,
  "max_rule_chars": 300,
  "max_local_skill_bytes": 8192,
  "known_good_generations": 2,
  "max_new_learned_skills": 0,
  "max_evidence_bytes": 10485760,
  "retention_days": 30,
  "allow_no_change": true,
  "forbidden_automatic_changes": [
    "installed-plugin-cache",
    "bundled-skills",
    "source-control",
    "network-delivery",
    "authentication",
    "permissions",
    "dependencies",
    "mcp-schema",
    "preview-apply-safety",
    "publishing"
  ]
}
