*.0001.rvt
*.0002.rvt
*.rws
*.rvt.journal
*.slog

# Python bytecode (for any ancillary scripts)
__pycache__/
*.pyc
*.pyo

# Mirror temp files (safety-pattern Guard 4)
*.xlsx.tmp.*
*.backup.*.xlsx
